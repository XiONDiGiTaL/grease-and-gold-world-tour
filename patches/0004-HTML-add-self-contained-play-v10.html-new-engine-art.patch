+  const c1 = (-ny * h) * bend[0] + (nx * h) * bend[1];
+  const knee = c1 >= 0 ? [mx - ny * h, my + nx * h] : [mx + ny * h, my - nx * h];
+  return { mid: knee, end: [tx, ty], reach: d0 - dd };
