From 4e277b82e01904aef9cadc682dc97e75957b9f4d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 03:03:24 +0000
Subject: [PATCH 7/7] Build: dedicated src/shell.html template so
 tools/build.js no longer depends on the landing page; play-v<N> naming via
 package.json

---
 .gitignore     |  1 +
 package.json   | 12 ++++++++----
 src/shell.html | 37 +++++++++++++++++++++++++++++++++++++
 tools/build.js | 16 ++++++++--------
 4 files changed, 54 insertions(+), 12 deletions(-)
 create mode 100644 src/shell.html

diff --git a/.gitignore b/.gitignore
index 0f4df7b..963213a 100644
--- a/.gitignore
+++ b/.gitignore
@@ -1,2 +1,3 @@
 node_modules/
+package-lock.json
 godot/.godot/
diff --git a/package.json b/package.json
index 6e19ba6..06b92eb 100644
--- a/package.json
+++ b/package.json
@@ -1,15 +1,19 @@
 {
-  "name": "grease-and-gold",
+  "name": "grease-and-gold-world-tour",
   "version": "1.0.0",
   "description": "",
   "main": "index.js",
   "scripts": {
-    "test": "echo \"Error: no test specified\" && exit 1"
+    "build": "node tools/build.js",
+    "test": "node tests/run.js",
+    "sprites": "node tools/export_sprites.js",
+    "godot-data": "node tools/export_godot_data.js"
   },
   "keywords": [],
   "author": "",
   "license": "ISC",
   "dependencies": {
     "@napi-rs/canvas": "^1.0.11"
-  }
-}
+  },
+  "playVersion": 10
+}
\ No newline at end of file
diff --git a/src/shell.html b/src/shell.html
new file mode 100644
index 0000000..b8ceda5
--- /dev/null
+++ b/src/shell.html
@@ -0,0 +1,37 @@
+<!doctype html>
+<html lang="en"><head><meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
+<title>Grease &amp; Gold: World Tour</title>
+<style>
+:root{--ink:#14091c;--gold:#f2b630;--mag:#d93aa0;--cream:#f6ead0}
+html,body{margin:0;height:100%;background:var(--ink);overflow:hidden;overscroll-behavior:none;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
+body{display:flex;align-items:center;justify-content:center;padding:env(safe-area-inset-top,0) env(safe-area-inset-right,0) env(safe-area-inset-bottom,0) env(safe-area-inset-left,0);box-sizing:border-box}
+#view{image-rendering:pixelated;image-rendering:crisp-edges;display:block;touch-action:none;background:#000}
+#touch{display:none;position:fixed;inset:0;pointer-events:none;z-index:5}
+#touch.on{display:block}
+#touch>*{pointer-events:auto;touch-action:none}
+#dpad{position:absolute;left:calc(14px + env(safe-area-inset-left,0px));bottom:calc(14px + env(safe-area-inset-bottom,0px));width:150px;height:150px;border-radius:50%;background:rgba(20,9,28,.45);border:2px solid rgba(242,182,48,.55)}
+#dpad::before,#dpad::after{content:"";position:absolute;background:rgba(246,234,208,.35);border-radius:3px}
+#dpad::before{left:50%;top:14%;width:6px;height:72%;transform:translateX(-50%)}
+#dpad::after{top:50%;left:14%;height:6px;width:72%;transform:translateY(-50%)}
+.btn{position:absolute;width:68px;height:68px;border-radius:50%;background:rgba(20,9,28,.5);border:3px solid rgba(242,182,48,.75);color:var(--cream);font:900 14px "Arial Black",Impact,sans-serif;display:flex;align-items:center;justify-content:center;letter-spacing:.5px}
+.btn.down{background:rgba(242,182,48,.55);color:var(--ink)}
+#bA{right:calc(100px + env(safe-area-inset-right,0px));bottom:calc(22px + env(safe-area-inset-bottom,0px));width:78px;height:78px;border-color:#f2b630}
+#bJ{right:calc(18px + env(safe-area-inset-right,0px));bottom:calc(58px + env(safe-area-inset-bottom,0px))}
+#bS{right:calc(70px + env(safe-area-inset-right,0px));bottom:calc(112px + env(safe-area-inset-bottom,0px));border-color:var(--mag)}
+#bG{right:calc(150px + env(safe-area-inset-right,0px));bottom:calc(104px + env(safe-area-inset-bottom,0px));width:54px;height:54px;font-size:12px}
+#bP{right:calc(10px + env(safe-area-inset-right,0px));top:calc(8px + env(safe-area-inset-top,0px));width:38px;height:38px;font-size:15px;border-width:2px}
+@media (prefers-reduced-motion:reduce){*{transition:none!important}}
+</style></head>
+<body>
+<canvas id="view" width="768" height="432" aria-label="Grease and Gold: World Tour game"></canvas>
+<div id="touch">
+  <div id="dpad"></div>
+  <div class="btn" id="bA" data-btn="attack">ATK</div>
+  <div class="btn" id="bJ" data-btn="jump">JMP</div>
+  <div class="btn" id="bS" data-btn="special">SPC</div>
+  <div class="btn" id="bG" data-btn="grab">GRB</div>
+  <div class="btn" id="bP" data-btn="pause">II</div>
+</div>
+<!--SCRIPTS-->
+</body></html>
diff --git a/tools/build.js b/tools/build.js
index a60ec80..765d4f1 100644
--- a/tools/build.js
+++ b/tools/build.js
@@ -1,11 +1,11 @@
-// Bundles src/*.js + index.html into dist/grease-and-gold.html (single self-contained file).
+// Bundles src/*.js into the game shell (src/shell.html).
+// Output: play-v<N>.html (single self-contained file, N = package.json "playVersion") and play-dev.html (loads src/*.js).
 const fs = require('fs'), path = require('path'); const root = path.join(__dirname, '..');
+const pkg = JSON.parse(fs.readFileSync(path.join(root, 'package.json'), 'utf8')); const N = pkg.playVersion || 10;
 const order = ['sprites', 'input', 'audio', 'stages', 'game', 'ui', 'boot'];
-const html = fs.readFileSync(path.join(root, 'index.html'), 'utf8');
+const html = fs.readFileSync(path.join(root, 'src', 'shell.html'), 'utf8');
 const tags = order.map(n => '<script>\n' + fs.readFileSync(path.join(root, 'src', n + '.js'), 'utf8') + '\n</script>').join('\n');
-const scriptsSrc = order.map(n => '<script src="src/' + n + '.js"></script>').join('\n');
-fs.mkdirSync(path.join(root, 'dist'), { recursive: true });
-fs.writeFileSync(path.join(root, 'dist', 'grease-and-gold.html'), html.replace('<!--SCRIPTS-->', tags));
-// index.html keeps working from source (multi-file) when opened directly:
-fs.writeFileSync(path.join(root, 'play-dev.html'), html.replace('<!--SCRIPTS-->', scriptsSrc));
-console.log('built dist/grease-and-gold.html', (fs.statSync(path.join(root, 'dist', 'grease-and-gold.html')).size / 1024).toFixed(0) + ' KB');
+const dev = order.map(n => '<script src="src/' + n + '.js"></script>').join('\n');
+const out = path.join(root, 'play-v' + N + '.html');
+fs.writeFileSync(out, html.replace('<!--SCRIPTS-->', tags)); fs.writeFileSync(path.join(root, 'play-dev.html'), html.replace('<!--SCRIPTS-->', dev));
+console.log('built', path.basename(out), (fs.statSync(out).size / 1024).toFixed(0) + ' KB');
-- 
2.43.0

