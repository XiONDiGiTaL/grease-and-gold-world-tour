+
+const GRAV := 0.24
+const JUMPV := 4.7
+const WALKY := 1.0
+const DRAIN := 0.28
+const DROPS := ["adana", "adana", "adana", "shish", "shish", "lahmacun", "lahmacun", "kunefe", "doner"]
+
+func _ready() -> void:
+  var f := FileAccess.open("res://data/game_data.json", FileAccess.READ)
+  D = JSON.parse_string(f.get_as_text())
+  TIMING = D.TIMING
+  for b in BTN:
+    held[b] = false
+    buf[b] = 0
