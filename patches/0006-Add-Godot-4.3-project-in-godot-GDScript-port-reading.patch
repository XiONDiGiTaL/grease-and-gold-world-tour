+extends SceneTree
+## Renders real frames through Godot's renderer:  xvfb-run -a godot --path godot --rendering-driver opengl3 --script res://tests/shots.gd
+var g
+func shot(name: String) -> void:
+  await process_frame
+  await process_frame
+  var img: Image = root.get_viewport().get_texture().get_image()
+  img.resize(768, 432, Image.INTERPOLATE_NEAREST)
+  img.save_png("res://../shots_godot/%s.png" % name)
+func _initialize() -> void:
+  g = load("res://scripts/game.gd").new()
+  g.use_real_input = false
+  root.add_child(g)
+  await process_frame
+  await process_frame
+  g.state = "title"
+  g.t = 40
+  await shot("g01_title")
+  g.state = "select"
+  await shot("g02_select")
+  g.clear_input()
+  g.start_run("ricky")
+  g.start_stage(0)
+  var p = g.players[0]
+  p.invuln = 0
+  g.banner = 0
+  p.x = 130.0
+  g.cam_x = 70.0
+  var a = g.make_enemy("exec", 200.0, 175.0)
+  var b = g.make_enemy("guard", 250.0, 160.0)
+  a.state = "idle"
+  b.state = "idle"
+  a.cool = 999.0
+  b.cool = 999.0
+  g.enemies.append(a)
+  g.enemies.append(b)
+  g.items.append({"type": "adana", "x": 170.0, "y": 190.0, "z": 0.0, "life": 900, "t": 5, "taken": false})
+  g.items.append({"type": "shish", "x": 330.0, "y": 150.0, "z": 0.0, "life": 900, "t": 30, "taken": false})
+  await shot("g03_stage1")
+  g.clear_input()
+  g.start_run("vv")
+  g.start_stage(2)
+  p = g.players[0]
+  p.invuln = 0
+  g.banner = 0
+  p.x = 150.0
+  p.y = 172.0
+  g.cam_x = 90.0
+  p.hype = 80.0
+  for i in 3:
+    var e = g.make_enemy("raider", 175.0 + i * 22.0, 160.0 + i * 12.0)
+    e.state = "idle"
+    e.cool = 999.0
+    e.hp = 500.0
+    e.maxhp = 500.0
+    g.enemies.append(e)
+  g.set_btn("special", true)
+  for i in 20:
+    g.update()
+  await shot("g04_vv_special")
+  g.set_btn("special", false)
+  g.clear_input()
+  g.start_run("johnny")
+  g.start_stage(1)
+  p = g.players[0]
+  p.invuln = 0
+  g.banner = 0
+  p.x = 150.0
+  p.y = 172.0
+  g.cam_x = 90.0
+  var t = g.make_enemy("bigtony", 235.0, 172.0)
+  t.state = "idle"
+  t.cool = 999.0
+  t.hp = 200.0
+  g.enemies.append(t)
+  g.combo = {"n": 5, "t": 90, "pop": 0.0}
+  g.score = 4200
+  await shot("g05_boss_hud")
+  g.state = "pause"
+  g.show_help = true
+  g.menu = 2
+  await shot("g06_pause")
+  quit(0)
diff --git a/godot/tests/test.gd b/godot/tests/test.gd
new file mode 100644
index 0000000..1b1287a
--- /dev/null
+++ b/godot/tests/test.gd
@@ -0,0 +1,381 @@
+extends SceneTree
+## Headless checks for the Godot port:  godot --headless --path godot --script res://tests/test.gd
+var g
+var passed := 0
+var failed := 0
+
+func ok(c: bool, name: String, info = "") -> void:
+  if c:
+    passed += 1
+    print("PASS ", name)
+  else:
+    failed += 1
+    print("FAIL ", name, " -> ", info)
+
+func step(n := 1) -> void:
+  for i in n:
+    g.update()
+func press(b: String, hold := 1) -> void:
+  g.set_btn(b, true)
+  step(hold)
+  g.set_btn(b, false)
+func fresh(ch := "ricky", god := false):
+  g.clear_input()
+  g.god_mode = god
+  g.start_run(ch)
+  g.players[0].invuln = 0
+  return g.players[0]
+func put(type: String, dx: float, dy: float, st := "idle") -> Dictionary:
+  var p = g.players[0]
+  var e = g.make_enemy(type, p.x + dx, p.y + dy)
+  e.state = st
+  e.cool = 9999.0
+  e.face = -1 if dx > 0 else 1
+  g.enemies.append(e)
+  return e
+
+func _initialize() -> void:
+  g = load("res://scripts/game.gd").new()
+  g.use_real_input = false
+  root.add_child(g)
+  await process_frame
+  await process_frame
+  g.state = "title"
+  print("== data / assets")
+  var D = g.D
+  ok(D.players.size() == 3 and D.enemies.size() == 9, "3 players + 9 enemy kits in data")
+  var bad := []
+  for id in D.players + D.enemies:
+    var tex: Texture2D = load("res://assets/sprites/%s.png" % id)
+    if tex == null or tex.get_width() != 896:
+      bad.append(id)
+    for a in D.atlas[id]:
+      if not g.TIMING.has(a) or int(D.atlas[id][a].n) != g.TIMING[a].size():
+        bad.append(id + ":" + a)
+      if (int(D.atlas[id][a].row) + 1) * 112 > tex.get_height():
+        bad.append(id + ":" + a + ":row")
+  ok(bad.is_empty(), "every sprite sheet loads, is 8 columns of 112px, and atlas frame counts match animation timing", bad)
+  ok(g.renderer != null and g.renderer.sheets.size() == 12 and g.renderer.bgs.size() == 4, "renderer loaded all sheets and 4 stage backdrops")
+  print("== gameplay")
+  var p = fresh("ricky")
+  p.x = 120.0
+  g.cam_x = 60.0
+  var x0: float = p.x
+  var ph0: float = p.phase
+  var total := 0.0
+  var last: float = p.phase
+  g.set_btn("right", true)
+  for i in 60:
+    step()
+    var d: float = p.phase - last
+    if d < -0.5:
+      d += 1.0
+    total += d
+    last = p.phase
+  g.set_btn("right", false)
+  ok(p.x - x0 > 60.0, "holding right moves the fighter", p.x - x0)
+  ok(absf(total * 40.0 - (p.x - x0)) < 6.0, "walk-cycle phase advances with distance travelled (no foot sliding)", [total * 40.0, p.x - x0])
+  p = fresh("vv")
+  p.x = 150.0
+  g.cam_x = 90.0
+  var y0: float = p.y
+  var peak := 0.0
+  press("jump")
+  for i in 50:
+    step()
+    peak = maxf(peak, p.z)
+  ok(peak > 38.0 and peak < 52.0, "jump apex ~44px", peak)
+  ok(absf(p.y - y0) < 0.01, "jump leaves ground-plane lane unchanged")
+  ok(p.z == 0.0, "lands at z=0")
+  # combo
+  p = fresh("ricky")
+  g.enemies = []
+  p.x = 150.0
+  g.cam_x = 90.0
+  var e = put("exec", 40, 0)
+  e.hp = 500.0
+  e.maxhp = 500.0
+  var max_step := -1
+  var seen := {}
+  press("attack")
+  for i in 70:
+    if i == 6 or i == 17:
+      press("attack")
+    else:
+      step()
+    if p.state == "attack":
+      max_step = maxi(max_step, p.step)
+    seen[e.state] = true
+  ok(max_step == 2, "taps chain into buffered 3-hit combo", max_step)
+  ok(seen.has("knock") or seen.has("down"), "finisher knocks down", seen.keys())
+  # lane / direction
+  p = fresh("ricky")
+  g.enemies = []
+  p.x = 150.0
+  g.cam_x = 90.0
+  var a = put("exec", 40, 0)
+  var b = put("exec", 40, 32)
+  var c = put("exec", -40, 0)
+  var f = put("exec", 90, 0)
+  for q in [a, b, c, f]:
+    q.hp = 90.0
+  press("attack")
+  step(20)
+  ok(a.hp < 90.0, "in-lane enemy in front is hit")
+  ok(b.hp == 90.0, "other-lane enemy not hit", b.hp)
+  ok(c.hp == 90.0, "enemy behind not hit", c.hp)
+  ok(f.hp == 90.0, "out-of-reach enemy not hit")
+  # hitstop
+  p = fresh("johnny")
+  g.enemies = []
+  p.x = 150.0
+  g.cam_x = 90.0
+  e = put("exec", 36, 0)
+  e.hp = 200.0
+  press("attack")
+  var hs := 0
+  for i in 40:
+    step()
+    hs = maxi(hs, g.hitstop)
+  ok(hs > 0 and hs <= 9, "hit-stop brief (<=9 ticks)", hs)
+  # hype
+  p = fresh("vv")
+  g.enemies = []
+  p.x = 150.0
+  g.cam_x = 90.0
+  for i in 4:
+    var h = put("heavy", 24 + i * 6, (i - 1.5) * 4)
+    h.hp = 900.0
+    h.maxhp = 900.0
+  p.hype = 50.0
+  var h0: float = p.hype
+  g.set_btn("special", true)
+  step(2)
+  ok(p.state == "special", "special starts with HYPE")
+  var rose := false
+  var prev: float = p.hype
+  for i in 60:
+    step()
+    if p.hype > prev + 1e-9:
+      rose = true
+    prev = p.hype
+  ok(not rose, "special damage grants no HYPE")
+  ok(h0 - p.hype > 10.0 and h0 - p.hype < 25.0, "HYPE drains while held", h0 - p.hype)
+  g.set_btn("special", false)
+  step(2)
+  var hr: float = p.hype
+  step(30)
+  ok(p.state != "special" and absf(p.hype - hr) < 1e-9, "release stops special and drain")
+  p = fresh("ricky")
+  g.enemies = []
+  p.hype = 1.0
+  p.x = 150.0
+  g.cam_x = 90.0
+  g.set_btn("special", true)
+  step(12)
+  ok(p.state != "special" and p.hype == 0.0, "special stops at 0 HYPE", [p.state, p.hype])
+  g.set_btn("special", false)
+  p = fresh("ricky")
+  g.enemies = []
+  p.hype = 0.0
