[application]
config/name="Grease & Gold: World Tour"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")

[display]

[display/window]
size/viewport_width=480
size/viewport_height=270
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"
stretch/aspect="keep"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[physics]
common/enable_pause_aware_picking=true

[input]
move_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194311)]}
move_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194313)]}
move_up={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_down={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
attack={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":90)]}
special={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":88)]}
jump={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32)]}
interact={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":67)]}

[gui]
theme/default_font_multichannel_signed_distance_field=false
